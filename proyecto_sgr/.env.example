# Copia este archivo como .env y completa los valores de tu entorno.
# El archivo .env no se versiona: está excluido en .gitignore.

# Clave criptográfica de Django. Genera una propia para cada entorno con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SGR_SECRET_KEY=cambia-esta-clave-en-cada-entorno

# Modo depuración. "on" en desarrollo, "off" en el servidor.
SGR_DEBUG=on

# Dominios autorizados, separados por coma. En AWS va el dominio o IP pública.
SGR_ALLOWED_HOSTS=127.0.0.1,localhost

# Conexión a MySQL
SGR_DB_NAME=sgr
SGR_DB_USER=sgr_app
SGR_DB_PASSWORD=
SGR_DB_HOST=127.0.0.1
SGR_DB_PORT=3306

# --- Correo (envío del código de recuperación) ---------------------------
# Sin definir, el código se imprime en la consola donde corre runserver: el
# recorrido completo se puede probar sin servidor de correo.
# En el servidor se define el SMTP que corresponda.
SGR_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SGR_EMAIL_HOST=
SGR_EMAIL_PORT=587
SGR_EMAIL_USER=
SGR_EMAIL_PASSWORD=
SGR_EMAIL_TLS=on
SGR_EMAIL_FROM=sgr@ejemplo.cl

# Muestra el código de recuperación en pantalla, para la demostración.
# Sigue a SGR_DEBUG si no se define. En el servidor debe quedar en "off".
SGR_MOSTRAR_CODIGO=on

# Cookies solo por HTTPS. Encender cuando el servidor tenga certificado.
SGR_COOKIES_SEGURAS=off

# --- Evidencias (archivos adjuntos) --------------------------------------
# Formatos aceptados y tamaño máximo por archivo. Si se sube el máximo, Nginx
# tiene que aceptar ese tamaño (client_max_body_size).
SGR_EVIDENCIA_FORMATOS=pdf,jpg,jpeg,png
SGR_EVIDENCIA_MAX_MB=5
# Carpeta donde se guardan. Por omisión, media/ dentro del proyecto.
# SGR_MEDIA_ROOT=/home/ec2-user/sgr_archivos

# --- Cuentas de la carga de datos ficticios ------------------------------
# Solo las usa "manage.py cargar_datos_demo". No son credenciales reales.
SGR_DEMO_PASSWORD=Demo.Sgr2026
SGR_ADMIN_USER=revisor
SGR_ADMIN_PASSWORD=Sgr.Revision2026
SGR_ADMIN_EMAIL=revisor@ejemplo.cl
