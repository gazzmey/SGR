# Mensajes de validación de Django con el tono del SGR (tuteo).
#
# Django trae sus mensajes en español con «usted»: «Introduzca…»,
# «Escoja…», «Asegúrese…». El resto del sistema tutea, así que aquí se
# reemplazan solo esos; todo lo demás sigue saliendo del catálogo español
# de Django. Lo carga LOCALE_PATHS en config/settings.py.
#
# Después de editar este archivo hay que compilarlo a django.mo:
#     python manage.py compilemessages   (necesita gettext instalado)
# o, sin gettext:
#     python -c "from babel.messages.pofile import read_po; from babel.messages.mofile import write_mo; write_mo(open('locale/es/LC_MESSAGES/django.mo','wb'), read_po(open('locale/es/LC_MESSAGES/django.po','rb')))"
msgid ""
msgstr ""
"Project-Id-Version: SGR\n"
"POT-Creation-Date: 2026-11-16 21:21-0300\n"
"PO-Revision-Date: 2026-11-16 21:30-0300\n"
"Last-Translator: Equipo SGR\n"
"Language: es\n"
"Language-Team: Equipo SGR\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Generated-By: Babel 2.18.0\n"

msgid "Enter a valid value."
msgstr "Revisa este dato: no tiene un formato válido."

msgid "Enter a valid URL."
msgstr "Escribe una dirección web válida."

msgid "Enter a valid integer."
msgstr "Escribe un número entero."

msgid "Enter a valid email address."
msgstr "Escribe un correo válido, por ejemplo nombre@ejemplo.cl."

#, python-format
msgid "Ensure this value is less than or equal to %(limit_value)s."
msgstr "Debe ser menor o igual a %(limit_value)s."

#, python-format
msgid "Ensure this value is greater than or equal to %(limit_value)s."
msgstr "Debe ser mayor o igual a %(limit_value)s."

#, python-format
msgid "Ensure this value is a multiple of step size %(limit_value)s."
msgstr "Debe ser múltiplo de %(limit_value)s."

msgid "Enter a number."
msgstr "Escribe un número."

msgid "Enter a whole number."
msgstr "Escribe un número entero."

msgid "Enter a valid date."
msgstr "Escribe una fecha válida."

msgid "Enter a valid time."
msgstr "Escribe una hora válida."

msgid "Enter a valid date/time."
msgstr "Escribe una fecha y hora válidas."

msgid "Enter a valid duration."
msgstr "Escribe una duración válida."

msgid "No file was submitted. Check the encoding type on the form."
msgstr "No llegó ningún archivo. Vuelve a adjuntarlo."

msgid "No file was submitted."
msgstr "No llegó ningún archivo."

msgid "The submitted file is empty."
msgstr "El archivo está vacío."

msgid "Please either submit a file or check the clear checkbox, not both."
msgstr "Adjunta un archivo o marca la casilla para quitarlo, no las dos cosas."

msgid "Upload a valid image. The file you uploaded was either not an image or a corrupted image."
msgstr "Adjunta una imagen válida: el archivo no es una imagen o está dañado."

#, python-format
msgid "Select a valid choice. %(value)s is not one of the available choices."
msgstr "Elige una opción de la lista: %(value)s no está disponible."

msgid "Select a valid choice. That choice is not one of the available choices."
msgstr "Elige una opción de la lista: la que llegó no está disponible."

msgid "Enter a list of values."
msgstr "Escribe una lista de valores."

msgid "Enter a complete value."
msgstr "Completa el valor."

#, python-format
msgid "Please correct the duplicate data for %(field)s."
msgstr "Corrige el dato repetido en %(field)s."

#, python-format
msgid "Please correct the duplicate data for %(field)s, which must be unique."
msgstr "Corrige el dato repetido en %(field)s: no se puede repetir."

msgid "Please correct the duplicate values below."
msgstr "Corrige los valores repetidos."

#, python-format
msgid "Ensure this value has at least %(limit_value)d character (it has %(show_value)d)."
msgid_plural "Ensure this value has at least %(limit_value)d characters (it has %(show_value)d)."
msgstr[0] "Escribe al menos %(limit_value)d carácter (escribiste %(show_value)d)."
msgstr[1] "Escribe al menos %(limit_value)d caracteres (escribiste %(show_value)d)."

#, python-format
msgid "Ensure this value has at most %(limit_value)d character (it has %(show_value)d)."
msgid_plural "Ensure this value has at most %(limit_value)d characters (it has %(show_value)d)."
msgstr[0] "Escribe como máximo %(limit_value)d carácter (escribiste %(show_value)d)."
msgstr[1] "Escribe como máximo %(limit_value)d caracteres (escribiste %(show_value)d)."

#, python-format
msgid "Ensure that there are no more than %(max)s digit in total."
msgid_plural "Ensure that there are no more than %(max)s digits in total."
msgstr[0] "Usa como máximo %(max)s dígito en total."
msgstr[1] "Usa como máximo %(max)s dígitos en total."

#, python-format
msgid "Ensure that there are no more than %(max)s decimal place."
msgid_plural "Ensure that there are no more than %(max)s decimal places."
msgstr[0] "Usa como máximo %(max)s decimal."
msgstr[1] "Usa como máximo %(max)s decimales."

#, python-format
msgid "Ensure that there are no more than %(max)s digit before the decimal point."
msgid_plural "Ensure that there are no more than %(max)s digits before the decimal point."
msgstr[0] "Usa como máximo %(max)s dígito antes de la coma decimal."
msgstr[1] "Usa como máximo %(max)s dígitos antes de la coma decimal."

#, python-format
msgid "Ensure this filename has at most %(max)d character (it has %(length)d)."
msgid_plural "Ensure this filename has at most %(max)d characters (it has %(length)d)."
msgstr[0] "El nombre del archivo puede tener como máximo %(max)d carácter (tiene %(length)d)."
msgstr[1] "El nombre del archivo puede tener como máximo %(max)d caracteres (tiene %(length)d)."

